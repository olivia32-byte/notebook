rules_version = '2';
// 두암 디지털 공책 보안 규칙
// - 선생님: 자기가 만든 반의 학생 공책을 모두 읽고, 피드백(빨간 펜·도장)과 학생 등록을 할 수 있어요.
// - 학생: 자기 공책만 읽고 쓸 수 있어요. 다른 친구 공책은 볼 수 없어요.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher(c) {
      return signedIn() && get(/databases/$(database)/documents/classes/$(c)).data.teacherUid == request.auth.uid;
    }
    function isMember(c) {
      return signedIn() && exists(/databases/$(database)/documents/classes/$(c)/members/$(request.auth.uid));
    }
    function isStudent(c, s) {
      return signedIn() && get(/databases/$(database)/documents/classes/$(c)/students/$(s)).data.uid == request.auth.uid;
    }

    match /classes/{c} {
      allow read: if signedIn() && resource.data.teacherUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if isTeacher(c);

      // 학생 로그인 때 번호만 확인하는 명단 (이름·비밀번호는 없음)
      match /public/{d} {
        allow read: if true;
        allow write: if isTeacher(c);
      }

      // 반 학생 명단 (로그인 계정 → 번호). 학습지를 볼 수 있는지 확인하는 데 써요.
      match /members/{u} {
        allow read: if isTeacher(c) || (signedIn() && request.auth.uid == u);
        allow write: if isTeacher(c);
      }

      // 선생님이 나눠 준 학습지 그림 (반에 한 번만 저장)
      match /handouts/{h} {
        allow read: if isTeacher(c) || isMember(c);
        allow write: if isTeacher(c);
        match /pages/{p} {
          allow read: if isTeacher(c) || isMember(c);
          allow write: if isTeacher(c);
        }
      }

      match /students/{s} {
        allow read: if isTeacher(c) || isStudent(c, s);
        allow create, delete: if isTeacher(c);
        allow update: if isTeacher(c)
          || (isStudent(c, s) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['current', 'updated', 'lastMsgAt']));

        match /notebooks/{nb} {
          allow read: if isTeacher(c) || isStudent(c, s);
          allow write: if isStudent(c, s) || isTeacher(c);   // 선생님은 학습지를 넣을 때 써요

          match /pages/{pg} {
            allow read: if isTeacher(c) || isStudent(c, s);
            allow write: if isStudent(c, s) || isTeacher(c);

            match /notes/{n} {
              allow read: if isTeacher(c) || isStudent(c, s);
              allow write: if isTeacher(c);
            }
            match /chat/{m} {
              allow read: if isTeacher(c) || isStudent(c, s);
              allow create: if (isTeacher(c) && request.resource.data.from == 't')
                            || (isStudent(c, s) && request.resource.data.from == 's');
            }
          }
        }
      }
    }
  }
}
